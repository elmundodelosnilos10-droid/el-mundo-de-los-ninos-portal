# Configurar como secretos del Site antes de habilitar cuentas escolares.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=https://your-school-site.example
# El valor predeterminado es better-auth. "supabase" solo activa la autenticación;
# cuentas, roles y datos escolares siguen en D1 hasta completar la migración.
SCHOOL_AUTH_PROVIDER=better-auth
# Proveedor de datos escolares. Mantener en d1 hasta importar y verificar datos y RLS.
SCHOOL_DATA_PROVIDER=d1
## Enable only after the school realtime publication migration is reviewed/applied.
## Requires SCHOOL_AUTH_PROVIDER=supabase and SCHOOL_DATA_PROVIDER=supabase.
SCHOOL_REALTIME_PROVIDER=disabled
SCHOOL_SETUP_TOKEN=replace-with-a-separate-random-secret-of-at-least-32-characters
# Opción Gmail API: usa OAuth para enviar desde la cuenta escolar.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=school-account@gmail.com
# Alternativa: Resend requiere un remitente de dominio verificado.
RESEND_API_KEY=replace-with-a-Resend-api-key
EMAIL_FROM=El Mundo de los Niños <acceso@your-school-domain.example>
# Proyecto Supabase de la escuela. La autenticación opcional ya puede usar estas
# variables. La autenticación y los datos se configuran por separado; el portal
# aún conserva D1/R2 como fuentes principales hasta completar migración y pruebas.
SUPABASE_URL=
# Clave publishable (sb_publishable_...), puede usarse en operaciones Auth normales.
SUPABASE_PUBLISHABLE_KEY=
# Clave Secret de servidor (sb_secret_...), nunca publicar ni compartir en el cliente.
SUPABASE_SECRET_KEY=
# Bucket privado para documentos cuando se active el backend de archivos Supabase.
SUPABASE_STORAGE_BUCKET=school-files
# R2 continúa como predeterminado. Cambiar a supabase solo en un entorno preparado.
SCHOOL_FILE_STORAGE_PROVIDER=r2
# Escáner HTTP privado aprobado por la escuela; la carga falla cerrada si falta.
SCHOOL_FILE_SCAN_URL=
SCHOOL_FILE_SCAN_TOKEN=
# Respaldos manuales: variables locales del operador, nunca secretos del Site.
SCHOOL_CF_ACCOUNT_ID=
SCHOOL_R2_BUCKET=
SCHOOL_D1_DATABASE=
SCHOOL_R2_READ_ACCESS_KEY_ID=
SCHOOL_R2_READ_SECRET_ACCESS_KEY=
SCHOOL_R2_WRITE_ACCESS_KEY_ID=
SCHOOL_R2_WRITE_SECRET_ACCESS_KEY=
SCHOOL_BACKUP_PASSPHRASE=
