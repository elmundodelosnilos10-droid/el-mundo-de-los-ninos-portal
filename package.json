{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:smoke": "node tests/smoke.mjs",
    "test:smoke:isolated": "node scripts/run-smoke-isolated.mjs",
    "test:communication-hours": "node --experimental-strip-types --test tests/communication-hours.test.mjs",
    "test:privacy-policy": "node --experimental-strip-types --test tests/privacy-request-policy.test.mjs",
    "test:upload-request-guard": "node --experimental-strip-types --test tests/upload-request-guard.test.mjs",
    "test:polling-policy": "node --experimental-strip-types --test tests/polling-policy.test.mjs",
    "test:images": "node --experimental-strip-types --test tests/image-metadata.test.mjs",
    "test:backup": "node --test tests/backup-crypto.test.mjs tests/backup-integration.test.mjs",
    "test:supabase-schema": "node --test tests/supabase-schema.test.mjs",
    "test:supabase-admin-database": "node --experimental-strip-types --test tests/supabase-admin-database.test.mjs",
    "test:supabase-database-rpc": "node --experimental-strip-types --test tests/supabase-database-rpc.test.mjs",
    "test:supabase-guardian-link": "node --test tests/supabase-guardian-link-rpc.test.mjs",
    "test:supabase-student-guardians": "node --experimental-strip-types --test tests/supabase-student-guardians.test.mjs",
    "test:supabase-school-directory": "node --experimental-strip-types --test tests/supabase-school-directory.test.mjs",
    "test:supabase-rls": "node --test tests/supabase-rls.test.mjs",
    "test:supabase-storage": "node --test tests/supabase-storage.test.mjs",
    "test:file-storage": "node --experimental-strip-types --test tests/file-storage.test.mjs",
    "test:auth-link": "node --experimental-strip-types --test tests/supabase-auth-link.test.mjs",
    "test:invitation-recovery": "node --experimental-strip-types --test tests/supabase-invitation-recovery.test.mjs",
    "test:supabase-identity-migration": "node --test tests/supabase-identity-migration.test.mjs",
    "test:supabase-d1-row-transform": "node --test tests/supabase-d1-row-transform.test.mjs",
    "test:supabase-d1-migration-preflight": "node --test tests/supabase-d1-migration-preflight.test.mjs",
    "supabase:d1-preflight": "node scripts/supabase-d1-migration-preflight.mjs",
    "backup:supabase": "node scripts/supabase-school-backup.mjs",
    "test:recovery-email": "node --experimental-strip-types --test tests/recovery-email.test.mjs",
    "test:file-scan": "node --experimental-strip-types --test tests/file-scanner.test.mjs",
    "backup:school": "node scripts/school-backup.mjs",
    "supabase:d1-import": "node scripts/supabase-d1-import.mjs",
    "test:supabase-d1-import": "node --test tests/supabase-d1-import.test.mjs",
    "dev:vercel": "next dev --hostname 127.0.0.1",
    "build:vercel": "next build --webpack",
    "start:vercel": "next start --hostname 127.0.0.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/realtime-js": "2.117.3",
    "better-auth": "^1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "web-push": "3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
